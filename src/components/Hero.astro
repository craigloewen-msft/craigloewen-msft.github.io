---
import { Image } from 'astro:assets';
import { site, socials } from '@/lib/site';
import { getSpeaking } from '@/lib/speaking';
import ActionLink from './ActionLink.astro';
import Icon from './Icon.astro';

/*
 * TODO(craig): swap this for a current photo when you have one. Best options, in
 * order: a recent Build or Ignite stage shot at 3:2 or wider, or a proper
 * headshot. This one is Ubuntu Summit 2023 — good, but the slide behind you
 * still reads "Senior Product Manager".
 */
import portrait from '@/assets/img/wsltalk.jpg';

const { stats } = await getSpeaking();

const proof = [
  { value: '5M+', label: 'developers use WSL' },
  { value: '2018', label: 'leading it since' },
  { value: String(stats.talks), label: 'conference talks' },
  { value: String(stats.countries), label: 'countries spoken in' },
];
---

<section class="grain relative overflow-hidden">
  {/* Accent glow + dot grid backdrop */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="bg-dotgrid absolute inset-0 opacity-60"></div>
    <div
      class="absolute -top-40 left-1/2 h-[36rem] w-[56rem] -translate-x-1/2 rounded-full blur-[120px]"
      style="background: var(--glow-accent)"
    ></div>
    <div
      class="absolute inset-x-0 bottom-0 h-40"
      style="background: linear-gradient(to bottom, transparent, var(--surface-base))"
    ></div>
  </div>

  <div class="mx-auto max-w-6xl px-5 pt-32 pb-8 sm:px-8 sm:pt-40 sm:pb-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div>
        <p class="flex items-center gap-1.5 font-mono text-xs tracking-[0.14em] uppercase">
          <span aria-hidden="true" style="color: var(--tone-accent)">
            {' '}
            ~${' '}
          </span>
          <span class="text-(--text-muted)">whoami</span>
          <span
            aria-hidden="true"
            class="ml-0.5 inline-block h-[1em] w-[0.5em] animate-(--animate-cursor-blink)"
            style="background: var(--tone-accent)"
          ></span>
        </p>

        <h1 class="mt-5 text-5xl leading-[1.05] font-semibold sm:text-6xl lg:text-7xl">
          Craig Loewen
        </h1>

        <p class="mt-5 max-w-xl text-lg text-(--text-secondary) sm:text-xl">
          Principal Product Manager at Microsoft. I own the{' '}
          <span class="text-(--text-primary)">Windows Subsystem for Linux</span> — how millions of
          developers run Linux on Windows — and parts of the Windows developer experience.
        </p>

        <p class="mt-4 max-w-xl text-(--text-muted)">
          I've spent eight years on one problem: getting the machine in front of a developer out of
          their way. That has meant rebuilding WSL on a real Linux kernel, taking it into the
          enterprise, and in 2025 opening the whole thing up as open source. Now it means working
          out what all of that becomes with an agent in the loop.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <ActionLink href={site.resume} icon="document" analytics="see_resume" external>
            Resume
          </ActionLink>
          <ActionLink href="/speaking" variant="ghost" icon="mic">
            {' '}
            What I speak about{' '}
          </ActionLink>
        </div>

        <ul class="mt-9 flex flex-wrap items-center gap-4">
          {socials.map((s) => (
            <li>
              <a
                href={s.url}
                data-analytics={`contact_${s.icon}`}
                rel={s.icon === 'mail' ? undefined : 'me noopener'}
                target={s.icon === 'mail' ? undefined : '_blank'}
                class="inline-flex items-center gap-2 font-mono text-xs text-(--text-muted) transition-colors hover:text-(--tone-accent)"
              >
                <Icon name={s.icon} size={16} />
                <span>{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <figure class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div
          class="absolute -inset-3 -z-10 rounded-2xl blur-2xl"
          style="background: var(--glow-accent)"
          aria-hidden="true"
        ></div>
        <Image
          src={portrait}
          alt="Craig Loewen presenting a talk about WSL on stage at Ubuntu Summit 2023"
          width={1200}
          height={900}
          loading="eager"
          fetchpriority="high"
          class="aspect-4/3 w-full rounded-2xl border border-(--surface-border) object-cover object-[54%_center] shadow-2xl"
        />
        <figcaption class="mt-3 font-mono text-xs text-(--text-muted)">
          Ubuntu Summit 2023 · Riga, Latvia
        </figcaption>
      </figure>
    </div>

    {/* Publicly verifiable claims only — no internal numbers. */}
    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-(--surface-border) bg-(--surface-border) sm:grid-cols-4">
      {proof.map((item) => (
        <div class="bg-(--surface-raised) px-5 py-6">
          <dt class="sr-only">{item.label}</dt>
          <dd>
            <span class="block text-3xl font-semibold" style="color: var(--tone-accent)">
              {item.value}
            </span>
            <span class="mt-1 block text-sm text-(--text-muted)">{item.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
