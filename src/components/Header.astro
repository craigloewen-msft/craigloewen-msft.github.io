---
import { navLinks, site } from '@/lib/site';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.vue';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
  data-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href="/"
      class="group inline-flex items-center gap-2 font-mono text-sm font-medium tracking-tight"
      aria-label={`${site.title} — home`}
    >
      <span aria-hidden="true" style="color: var(--tone-accent)">
        ~$
      </span>
      <span class="transition-colors group-hover:text-(--tone-accent)">craigloewen</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-lg px-3 py-2 text-sm transition-colors',
            isActive(link.href)
              ? 'text-(--tone-accent)'
              : 'text-(--text-secondary) hover:text-(--text-primary)',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-command-trigger
        class="hidden items-center gap-2 rounded-lg border border-(--surface-border) px-2.5 py-1.5 font-mono text-xs text-(--text-muted) transition-colors hover:border-(--tone-accent) hover:text-(--tone-accent) sm:inline-flex"
        aria-label="Open command palette"
      >
        <Icon name="search" size={14} />
        <kbd class="font-mono">⌘K</kbd>
      </button>

      <ThemeToggle client:load />

      <button
        type="button"
        data-menu-trigger
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="grid size-9 place-items-center rounded-lg border border-(--surface-border) text-(--text-secondary) transition-colors hover:border-(--tone-accent) hover:text-(--tone-accent) md:hidden"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    hidden
    aria-label="Mobile"
    class="border-t border-(--surface-border) bg-(--surface-raised) px-5 py-3 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'block rounded-lg px-3 py-2.5 text-sm transition-colors',
              isActive(link.href)
                ? 'text-(--tone-accent)'
                : 'text-(--text-secondary) hover:text-(--text-primary)',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  function setupHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
    const nav = document.getElementById('mobile-nav');
    if (!header) return;

    const onScroll = () => {
      const scrolled = window.scrollY > 12;
      header.classList.toggle('bg-(--surface-base)/80', scrolled);
      header.classList.toggle('backdrop-blur-lg', scrolled);
      header.classList.toggle('border-(--surface-border)', scrolled);
      header.classList.toggle('border-transparent', !scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    if (trigger && nav) {
      trigger.addEventListener('click', () => {
        const open = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!open));
        trigger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
        nav.hidden = open;
      });
    }
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
