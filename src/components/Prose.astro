---
/**
 * Typography for rendered Markdown/MDX bodies.
 *
 * Includes a compatibility layer for legacy Bootstrap 3 classes that are baked
 * into the original Jekyll post bodies (.container, .row, .col-md-6,
 * .img-responsive, .video-container, .chart-display, .blog-bullet-points).
 * Those posts are historical content we don't want to rewrite by hand.
 */
---

<div class="prose-body">
  <slot />
</div>

<style is:global>
  .prose-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose-body > * + * {
    margin-top: 1.25em;
  }

  .prose-body h1,
  .prose-body h2,
  .prose-body h3,
  .prose-body h4 {
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.25;
    scroll-margin-top: 6rem;
  }

  .prose-body h1 {
    font-size: 2rem;
    margin-top: 2.5em;
  }
  .prose-body h2 {
    font-size: 1.6rem;
    margin-top: 2.2em;
  }
  .prose-body h3 {
    font-size: 1.3rem;
    margin-top: 1.9em;
  }
  .prose-body h4 {
    font-size: 1.1rem;
    margin-top: 1.7em;
  }

  .prose-body a {
    color: var(--tone-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: opacity 0.2s;
  }
  .prose-body a:hover {
    opacity: 0.75;
  }

  .prose-body strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .prose-body ul,
  .prose-body ol {
    padding-left: 1.5em;
  }
  .prose-body ul {
    list-style: disc;
  }
  .prose-body ol {
    list-style: decimal;
  }
  .prose-body li + li {
    margin-top: 0.5em;
  }
  .prose-body li::marker {
    color: var(--tone-accent);
  }

  .prose-body blockquote {
    border-left: 2px solid var(--tone-accent);
    padding-left: 1.25em;
    font-style: italic;
    color: var(--text-muted);
  }

  .prose-body hr {
    border: 0;
    border-top: 1px solid var(--surface-border);
    margin: 2.5em 0;
  }

  .prose-body img,
  .prose-body video {
    max-width: 100%;
    height: auto;
    border-radius: 0.6rem;
    border: 1px solid var(--surface-border);
  }

  .prose-body figure figcaption {
    margin-top: 0.6em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* Inline code */
  .prose-body :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--surface-raised);
    border: 1px solid var(--surface-border);
    border-radius: 0.35rem;
    padding: 0.15em 0.4em;
    color: var(--text-primary);
  }

  /* Shiki code blocks — dual theme driven by the `light` class */
  .prose-body pre.astro-code {
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-card);
    padding: 1.15rem 1.25rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.65;
    tab-size: 2;
  }

  .prose-body pre.astro-code code {
    font-family: var(--font-mono);
  }

  .prose-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }
  .prose-body th,
  .prose-body td {
    border: 1px solid var(--surface-border);
    padding: 0.6em 0.85em;
    text-align: left;
  }
  .prose-body th {
    background: var(--surface-raised);
    color: var(--text-primary);
    font-weight: 600;
  }

  /* ------------------------------------------------------------------ *
   * Legacy Bootstrap 3 compatibility for pre-migration post bodies.
   * ------------------------------------------------------------------ */
  .prose-body .container {
    width: 100%;
    max-width: 100%;
    padding: 0;
  }

  .prose-body .row {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .prose-body .row:has(.col-md-6, .col-xl-6) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .prose-body .img-responsive {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .prose-body .chart-display {
    max-width: 100%;
    margin-inline: auto;
  }

  .prose-body .blog-bullet-points {
    list-style: disc;
    padding-left: 1.5em;
  }

  /* 16:9 responsive embed wrapper used by older posts */
  .prose-body .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--surface-border);
  }

  .prose-body .video-container iframe,
  .prose-body .video-container object,
  .prose-body .video-container embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .prose-body .text-center {
    text-align: center;
  }
</style>
