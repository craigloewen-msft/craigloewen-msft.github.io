---
import { site } from '@/lib/site';
const { analyticsId } = site;
---

{/* GA4, loaded deferred. Events are wired via `data-analytics` attributes rather than inline handlers. */}
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
<script is:inline define:vars={{ analyticsId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', analyticsId);

  // Single delegated listener replaces the inline onclick handlers the old site used.
  document.addEventListener(
    'click',
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest('[data-analytics]');
      if (!trigger) return;
      const name = trigger.getAttribute('data-analytics');
      if (name) gtag('event', name);
    },
    { passive: true },
  );
</script>
