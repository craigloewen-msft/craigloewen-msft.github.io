---
import Prompt from './Prompt.astro';
import Icon from './Icon.astro';

interface Props {
  kicker: string;
  title: string;
  href?: string;
  hrefLabel?: string;
  class?: string;
}
const { kicker, title, href, hrefLabel = 'View all', class: className = '' } = Astro.props;
---

<div class={`flex flex-wrap items-end justify-between gap-4 ${className}`}>
  <div>
    <Prompt label={kicker} />
    <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{title}</h2>
  </div>
  {href && (
    <a
      href={href}
      class="group inline-flex items-center gap-1.5 font-mono text-sm text-(--text-muted) transition-colors hover:text-(--tone-accent)"
    >
      {hrefLabel}
      <Icon
        name="arrowRight"
        size={16}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  )}
</div>
