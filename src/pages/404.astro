---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionLink from '@/components/ActionLink.astro';
import Prompt from '@/components/Prompt.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="grain relative mx-auto grid min-h-[70vh] max-w-2xl place-items-center px-5 text-center">
    <div
      class="bg-dotgrid pointer-events-none absolute inset-0 -z-10 opacity-40"
      aria-hidden="true"
    ></div>

    <div>
      <Prompt label="404" cursor />
      <h1 class="mt-5 text-5xl font-semibold sm:text-6xl">Page not found</h1>
      <p class="mt-5 text-(--text-muted)">
        That path doesn't resolve. It may have moved when the site was rebuilt.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <ActionLink href="/">Go home</ActionLink>
        <ActionLink href="/writing" variant="ghost">
          Browse writing
        </ActionLink>
      </div>

      <p class="mt-8 font-mono text-xs text-(--text-muted)">
        Or press <kbd class="rounded border border-(--surface-border) px-1.5 py-0.5">Ctrl K</kbd> to
        search.
      </p>
    </div>
  </section>
</BaseLayout>
