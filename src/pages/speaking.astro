---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SpeakingMap from '@/components/SpeakingMap.astro';
import StreamRow from '@/components/StreamRow.astro';
import ActionLink from '@/components/ActionLink.astro';
import { bio, site } from '@/lib/site';
import { getSpeaking } from '@/lib/speaking';
import type { StreamItem } from '@/lib/stream';

import panel from '@/assets/img/panel.jpg';
import buildDemo from '@/assets/img/build-2024-ai-demo.jpg';
import conferenceTalk from '@/assets/img/conferencetalk.jpg';

const { cities, stats } = await getSpeaking();

const talks = await getCollection('talks');
const recent = talks
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 8)
  .map<StreamItem>((t) => ({
    title: t.data.title,
    kind: 'Talk',
    date: t.data.date,
    href: t.data.url ?? '',
    external: true,
    venue: [t.data.conference, t.data.location].filter(Boolean).join(' · ') || undefined,
  }));

/*
 * Topics rather than a chronological list: the point of this page is what I can
 * be asked to talk about, not everything I have already said.
 */
const topics = [
  {
    title: 'Linux and Windows on the same machine',
    body: 'Why a Windows box became a reasonable place to do Linux work, what it cost to get there, and what still does not fit. The architecture, the trade-offs, and the decisions I would make differently.',
  },
  {
    title: 'Open source inside a large company',
    body: 'We took WSL from a closed Microsoft component to a fully open repository. What actually changes when you do that — governance, review load, roadmap pressure, and the parts nobody warns you about.',
  },
  {
    title: 'Developer tools with an agent in the loop',
    body: 'What survives when a capable model sits next to the developer. Local models on device, exposing application capability through MCP, and which parts of the current toolchain stop making sense.',
  },
  {
    title: 'Product management for deeply technical products',
    body: 'Owning a platform when your users are engineers, your telemetry is thin by design, and the roadmap has to survive contact with an open source community.',
  },
];

const gallery = [
  { image: panel, alt: 'Craig speaking on an AI panel at Ubuntu Summit' },
  { image: buildDemo, alt: 'Craig running a live demo on stage at Microsoft Build 2024' },
  { image: conferenceTalk, alt: 'Craig presenting a WSL session at Developer Week' },
];
---

<BaseLayout
  title="Speaking"
  description={`Craig Loewen has given ${stats.talks} conference talks in ${stats.countries} countries, including Microsoft Build, Microsoft Ignite and Ubuntu Summit. Speaking topics, a speaker bio, and how to invite him.`}
  path="/speaking"
  image="/og/speaking.png"
>
  <PageHeader
    kicker="speaking"
    title="On stage"
    lead={`I have given ${stats.talks} talks since ${stats.firstYear} — Microsoft Build and Ignite keynote demos, Ubuntu Summit, SIGGRAPH, and conferences across ${stats.countries} countries. Here is what I talk about, and how to get hold of me.`}
  />

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <SpeakingMap cities={cities} stats={stats} />

    {/* What I speak about */}
    <section class="mt-24" data-reveal>
      <SectionHeading kicker="topics" title="What I speak about" />

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {topics.map((topic) => (
          <article class="surface-card p-7">
            <h3 class="text-lg font-semibold">{topic.title}</h3>
            <p class="mt-3 text-sm text-(--text-muted)">{topic.body}</p>
          </article>
        ))}
      </div>
    </section>

    {/* Photos */}
    <section class="mt-24" data-reveal>
      <div class="grid gap-5 sm:grid-cols-3">
        {gallery.map((shot) => (
          <Image
            src={shot.image}
            alt={shot.alt}
            width={640}
            height={430}
            loading="lazy"
            class="aspect-3/2 w-full rounded-xl border border-(--surface-border) object-cover"
          />
        ))}
      </div>
    </section>

    {/* Recent talks */}
    <section class="mt-24" data-reveal>
      <SectionHeading
        kicker="recent"
        title="Latest talks"
        href="/writing"
        hrefLabel="Full archive"
      />
      <ul class="mt-8 divide-y divide-(--surface-border) border-y border-(--surface-border)">
        {recent.map((item) => (
          <li>
            <StreamRow item={item} showDescription={false} />
          </li>
        ))}
      </ul>
    </section>

    {/* Press kit */}
    <section class="mt-24" data-reveal>
      <SectionHeading kicker="press kit" title="Bio and booking" />

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <div class="surface-card p-8">
          <p class="kicker">Short bio</p>
          <p class="mt-4 text-(--text-secondary)">{bio.short}</p>

          <p class="kicker mt-8">Long bio</p>
          <p class="mt-4 text-(--text-secondary)">{bio.long}</p>

          <button
            type="button"
            data-copy-bio
            data-bio={bio.long}
            class="mt-7 inline-flex items-center gap-2 rounded-lg border border-(--surface-border) px-3.5 py-2 font-mono text-xs text-(--text-muted) transition-colors hover:border-(--tone-accent) hover:text-(--tone-accent)"
          >
            Copy long bio
          </button>
        </div>

        <div class="surface-card p-8">
          <p class="kicker">Inviting me</p>
          <p class="mt-4 text-(--text-secondary)">
            Email is the surest way to reach me. Useful things to include: the date, the audience,
            roughly how long you want, and whether you want a talk, a demo or a panel.
          </p>
          <p class="mt-4 text-sm text-(--text-muted)">
            I only speak at events with a published and enforced code of conduct, and I will not sit
            on an all-male panel.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <ActionLink
              href={`mailto:${site.authorEmail}?subject=Speaking%20invitation`}
              icon="mail"
              analytics="contact_mail"
            >
              Invite me to speak
            </ActionLink>
            <ActionLink href={site.resume} variant="ghost" icon="document" external>
              Resume
            </ActionLink>
          </div>

          {/* TODO(craig): add a press headshot to /public and link it here. */}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initCopyBio() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-bio]');
    if (!button || button.dataset.copyReady) return;
    button.dataset.copyReady = 'true';

    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.bio ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press Ctrl+C to copy';
      }
      setTimeout(() => (button.textContent = label), 2000);
    });
  }

  initCopyBio();
  document.addEventListener('astro:page-load', initCopyBio);
</script>
