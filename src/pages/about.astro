---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ActionLink from '@/components/ActionLink.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site, socials } from '@/lib/site';

import portrait from '@/assets/img/WaterlooPhoto.jpg';
import wsltalk from '@/assets/img/wsltalk.jpg';
import panel from '@/assets/img/panel.jpg';
import developerTalk from '@/assets/img/developer-talk.jpg';

const talks = await getCollection('talks');

const stage = [
  { image: wsltalk, alt: 'Craig giving a talk about WSL' },
  { image: panel, alt: 'Craig speaking on a panel' },
  { image: developerTalk, alt: 'Craig presenting to developers' },
];
---

<BaseLayout
  title="About"
  description="Craig Loewen is a Product Manager at Microsoft working on the Windows Subsystem for Linux, and a Mechatronics Engineering graduate from the University of Waterloo."
  path="/about"
  image="/og/about.png"
>
  <PageHeader kicker="about" title="About me" />

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_0.7fr] lg:gap-16">
      <div class="space-y-5 text-lg text-(--text-secondary)">
        <p>
          My name's Craig Loewen. I'm a Product Manager at Microsoft, and before that I studied
          Mechatronics Engineering at the University of Waterloo.
        </p>
        <p>
          I pride myself on being a cross-discipline problem solver. I've worked across a wide range
          of industries, from automotive to software, and across a wide range of skills, from
          development to management. I enjoy designing, creating, and leaving things better than I
          found them.
        </p>
        <p>
          These days most of my time goes to the{' '}
          <strong class="text-(--text-primary)">Windows Subsystem for Linux</strong>, which is now
          fully open source, and to the broader question of what developer tools should look like in
          a world with capable coding agents.
        </p>
        <p>
          I'm a South African Canadian, and I've lived in Europe, Africa and Canada. Outside work
          you'll find me weight lifting, playing guitar, or hiking.
        </p>

        <div class="flex flex-wrap gap-3 pt-4">
          <ActionLink href={site.resume} icon="document" analytics="see_resume" external>
            Download my resume
          </ActionLink>
          <ActionLink href="/talks" variant="ghost" icon="mic">
            {talks.length} talks
          </ActionLink>
        </div>
      </div>

      <div>
        <Image
          src={portrait}
          alt="Craig Loewen"
          width={640}
          height={800}
          loading="eager"
          class="w-full rounded-2xl border border-(--surface-border) object-cover"
        />
      </div>
    </div>

    <section class="mt-24" data-reveal>
      <SectionHeading
        kicker="on stage"
        title="Out in the world"
        href="/talks"
        hrefLabel="All talks"
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {stage.map((shot) => (
          <Image
            src={shot.image}
            alt={shot.alt}
            width={560}
            height={380}
            loading="lazy"
            class="aspect-4/3 w-full rounded-xl border border-(--surface-border) object-cover"
          />
        ))}
      </div>
    </section>

    <section class="mt-24" data-reveal>
      <SectionHeading kicker="contact" title="Find me elsewhere" />
      <div class="mt-8 flex flex-wrap gap-3">
        {socials.map((s) => (
          <ActionLink
            href={s.url}
            variant="ghost"
            icon={s.icon}
            analytics={`contact_${s.icon}`}
            external={s.icon !== 'mail'}
          >
            {s.label}
          </ActionLink>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
