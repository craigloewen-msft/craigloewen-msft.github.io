---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Project archive"
  description="Engineering projects Craig Loewen built before Microsoft — award-winning accessibility hardware, machine learning experiments, quadcopters and production lines."
  path="/projects"
  image="/og/projects.png"
>
  <PageHeader
    kicker="archive"
    title="Before all this"
    lead="Engineering projects from university and my work terms, between 2016 and 2018. None of it is what I do now — it's how I learned to build, and I'd rather keep it than pretend it didn't happen."
  />

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</BaseLayout>
