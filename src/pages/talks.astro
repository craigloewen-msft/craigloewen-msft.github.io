---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import TalkExplorer from '@/components/TalkExplorer.vue';

const [talks, videos, articles] = await Promise.all([
  getCollection('talks'),
  getCollection('videos'),
  getCollection('externalPosts'),
]);

// One unified, sortable stream across all three sources.
const items = [
  ...talks.map((t) => ({
    title: t.data.title,
    kind: 'Talk' as const,
    date: t.data.date.toISOString(),
    year: t.data.date.getUTCFullYear(),
    conference: t.data.conference,
    location: t.data.location,
    url: t.data.url,
  })),
  ...videos.map((v) => ({
    title: v.data.title,
    kind: 'Video' as const,
    date: v.data.date.toISOString(),
    year: v.data.date.getUTCFullYear(),
    url: v.data.url,
  })),
  ...articles.map((a) => ({
    title: a.data.title,
    kind: 'Article' as const,
    date: a.data.date.toISOString(),
    year: a.data.date.getUTCFullYear(),
    url: a.data.url,
  })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const conferences = [...new Set(talks.map((t) => t.data.conference).filter(Boolean))];
---

<BaseLayout
  title="Talks"
  description="Conference talks, videos and articles by Craig Loewen, covering WSL, developer tooling and Windows."
  path="/talks"
  image="/og/talks.png"
>
  <PageHeader
    kicker="speaking"
    title="Talks & appearances"
    lead={`${talks.length} talks, ${videos.length} videos and ${articles.length} articles — from ${conferences.slice(0, 3).join(', ')} and beyond.`}
  />

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <TalkExplorer client:visible items={items} />

    <noscript>
      <ul class="divide-y divide-(--surface-border) border-y border-(--surface-border)">
        {items.map((item) => (
          <li class="py-4">
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              {item.title}
            </a>
            <span class="ml-2 font-mono text-xs text-(--text-muted)">
              {item.kind} · {item.year}
            </span>
          </li>
        ))}
      </ul>
    </noscript>
  </div>
</BaseLayout>
