---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContentStream from '@/components/ContentStream.astro';
import { getStream, countByKind } from '@/lib/stream';
import { getCollection } from 'astro:content';

const items = await getStream();
const counts = countByKind(items);

const talks = await getCollection('talks');
const conferences = [...new Set(talks.map((t) => t.data.conference).filter(Boolean))];
---

<BaseLayout
  title="Writing & talks"
  description="Everything Craig Loewen has written, presented or recorded — posts, Microsoft Dev Blogs articles, conference talks and videos on WSL, developer tooling and AI."
  path="/writing"
  image="/og/writing.png"
>
  <PageHeader
    kicker="writing & talks"
    title="Everything in one place"
    lead={`I write and speak about three things: how Linux and Windows end up on the same machine, what open source looks like from inside a large company, and how agents change the shape of developer tools. This is the full archive — ${counts.Post + counts.Article} posts and articles, ${counts.Talk} talks and ${counts.Video} videos, from ${conferences.slice(0, 3).join(', ')} and beyond.`}
  />

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <ContentStream items={items} />
  </div>
</BaseLayout>
