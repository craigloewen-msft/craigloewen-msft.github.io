---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StreamRow from '@/components/StreamRow.astro';
import ActionLink from '@/components/ActionLink.astro';
import Prompt from '@/components/Prompt.astro';
import Icon from '@/components/Icon.astro';
import { beliefs, now, socials } from '@/lib/site';
import { work } from '@/lib/work';
import { getStream } from '@/lib/stream';
import { getSpeaking } from '@/lib/speaking';

import konstanz from '@/assets/img/konstanz.jpg';
import wallrobot from '@/assets/img/wallrobot.jpg';
import climbing from '@/assets/img/climbing.jpg';

const stream = await getStream();
const recent = stream.slice(0, 6);

const { stats } = await getSpeaking();
const talks = await getCollection('talks');
const conferences = [...new Set(talks.map((t) => t.data.conference).filter(Boolean))];

const interests = [
  {
    title: 'Elsewhere',
    image: konstanz,
    alt: 'Konstanz, Germany',
    body: "I'm South African and Canadian, and I've lived and worked in Africa, Europe and North America. I speak enough German, French and Korean to be useful in the places I keep getting invited back to. Working somewhere unfamiliar is still the fastest way I know to get a different read on a problem.",
  },
  {
    title: 'Training',
    image: climbing,
    alt: 'Craig climbing outdoors',
    body: 'Lifting and climbing. It is the one part of my week with a completely unambiguous success metric, which is a nice change from the day job.',
  },
  {
    title: 'Making things',
    image: wallrobot,
    // TODO(craig): a photo of you playing guitar would suit this card better
    // than the jelly-bean robot, if you have one.
    alt: 'A robot built from scratch',
    body: 'I still build things with no business case attached — guitars, robots, half-finished side projects. It keeps me honest about how it actually feels to use the tools I ask other people to use.',
  },
];
---

<BaseLayout path="/">
  <Hero />

  {/* Now */}
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <div class="surface-card p-8 sm:p-10">
      <Prompt label="now" />
      <ul class="mt-6 space-y-3.5">
        {now.items.map((item) => (
          <li class="flex gap-3 text-(--text-secondary)">
            <span
              aria-hidden="true"
              class="mt-2 size-1.5 shrink-0 rounded-full"
              style="background: var(--tone-accent)"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* What I own */}
  <section id="work" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="work" title="What I own" />

    <p class="mt-5 max-w-2xl text-(--text-muted)">
      Three areas, one thesis: the machine in front of a developer should disappear. Everything
      below links to something public — a release, a repository, or a session you can watch.
    </p>

    <div class="mt-10 space-y-5">
      {work.map((area) => (
        <article class="surface-card p-8 sm:p-10">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h3 class="text-2xl font-semibold sm:text-3xl">{area.name}</h3>
            <p class="font-mono text-xs text-(--text-muted)">
              {area.role} · {area.period}
            </p>
          </div>

          <p class="mt-4 max-w-3xl text-(--text-secondary)">{area.summary}</p>

          <ul class="mt-6 space-y-3">
            {area.outcomes.map((outcome) => (
              <li class="flex gap-3 text-sm text-(--text-muted)">
                <Icon name="arrowRight" size={14} class="mt-1 shrink-0 text-(--tone-accent)" />
                <span>{outcome}</span>
              </li>
            ))}
          </ul>

          <ul class="mt-7 flex flex-wrap gap-2">
            {area.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics="work_link"
                  class="group inline-flex items-center gap-1.5 rounded-lg border border-(--surface-border) px-3 py-1.5 font-mono text-xs text-(--text-muted) transition-colors hover:border-(--tone-accent) hover:text-(--tone-accent)"
                >
                  {link.label}
                  <Icon name="arrowUpRight" size={12} class="opacity-60" />
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {/* Writing & talks */}
  <section id="writing" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading
      kicker="writing & talks"
      title="Working in public"
      href="/writing"
      hrefLabel="See everything"
    />

    <p class="mt-5 max-w-2xl text-(--text-muted)">
      I write and speak about three things: how Linux and Windows end up on the same machine, what
      open source looks like from inside a large company, and how agents change the shape of
      developer tools. {stats.talks} talks so far, from {conferences.slice(0, 3).join(', ')} and
      beyond, plus the Microsoft developer blogs.
    </p>

    <ul class="mt-10 divide-y divide-(--surface-border) border-y border-(--surface-border)">
      {recent.map((item) => (
        <li>
          <StreamRow item={item} showDescription={false} />
        </li>
      ))}
    </ul>
  </section>

  {/* Beliefs */}
  <section id="beliefs" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="opinions" title="How I think about developer tools" />

    <ol class="mt-10 grid gap-px overflow-hidden rounded-xl border border-(--surface-border) bg-(--surface-border) sm:grid-cols-2">
      {beliefs.map((belief, i) => (
        <li class="flex gap-4 bg-(--surface-raised) p-7">
          <span class="font-mono text-xs text-(--text-muted)">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="text-(--text-secondary)">{belief}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* When I'm not working */}
  <section id="beyond" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="offline" title="When I'm not working" />

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {interests.map((interest) => (
        <article class="surface-card overflow-hidden">
          <div class="aspect-4/3 overflow-hidden border-b border-(--surface-border)">
            <Image
              src={interest.image}
              alt={interest.alt}
              width={560}
              height={420}
              loading="lazy"
              class="size-full object-cover"
            />
          </div>
          <div class="p-6">
            <h3
              class="font-mono text-sm tracking-[0.14em] uppercase"
              style="color: var(--tone-accent)"
            >
              {interest.title}
            </h3>
            <p class="mt-3 text-sm text-(--text-muted)">{interest.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* Contact */}
  <section id="contact" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" data-reveal>
    <div class="surface-card grain relative overflow-hidden p-10 text-center sm:p-16">
      <div
        class="pointer-events-none absolute inset-x-0 -top-24 h-48 blur-[100px]"
        style="background: var(--glow-accent)"
        aria-hidden="true"
      ></div>

      <Prompt label="say hello" cursor />
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Get in touch</h2>
      <p class="mx-auto mt-4 max-w-lg text-(--text-muted)">
        Speaking at your event, running open source inside a big company, or where developer tools
        go next — I'm glad to talk about any of it. I also answer short questions from product
        managers earlier in their careers. Email is the surest way to reach me.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {socials.map((s) => (
          <ActionLink
            href={s.url}
            variant={s.icon === 'mail' ? 'primary' : 'ghost'}
            icon={s.icon}
            analytics={`contact_${s.icon}`}
            external={s.icon !== 'mail'}
          >
            {s.label}
          </ActionLink>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
