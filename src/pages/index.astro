---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ActionLink from '@/components/ActionLink.astro';
import Prompt from '@/components/Prompt.astro';
import Icon from '@/components/Icon.astro';
import { now, socials } from '@/lib/site';
import { formatMonthYear } from '@/lib/urls';

import konstanz from '@/assets/img/konstanz.jpg';
import wallrobot from '@/assets/img/wallrobot.jpg';
import climbing from '@/assets/img/climbing.jpg';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allTalks = await getCollection('talks');
const talks = allTalks.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
const conferences = [...new Set(allTalks.map((t) => t.data.conference).filter(Boolean))];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured).slice(0, 3);

const interests = [
  {
    title: 'Travelling',
    image: konstanz,
    alt: 'Konstanz, Germany',
    body: 'I love to travel and have lived in many different places. Most recently Konstanz, Germany, where I got to speak both German and French. Learning about new places and cultures is the fastest way I know to get a new perspective.',
  },
  {
    title: 'Building',
    image: wallrobot,
    alt: 'A robot built from scratch',
    body: 'I work on pet projects constantly. In 2014 I built a working quadcopter from scratch, programmed it, and learned to fly it. I have also built a hydrogen fuel cell powered RC car, and a robot that launches jelly beans into your mouth from across the room.',
  },
  {
    title: 'Training',
    image: climbing,
    alt: 'Craig climbing outdoors',
    body: 'The other way I push myself is physically, and outdoors. Lifting, climbing, and getting far enough from a screen that the only thing left to solve is the next hold.',
  },
];
---

<BaseLayout path="/">
  <Hero />

  {/* Now */}
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <div class="surface-card p-8 sm:p-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <Prompt label="now" />
        <span class="font-mono text-xs text-(--text-muted)">Updated {now.updated}</span>
      </div>
      <ul class="mt-6 space-y-3.5">
        {now.items.map((item) => (
          <li class="flex gap-3 text-(--text-secondary)">
            <span
              aria-hidden="true"
              class="mt-2 size-1.5 shrink-0 rounded-full"
              style="background: var(--tone-accent)"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Writing */}
  <section id="writing" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="writing" title="Selected posts" href="/writing" />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  {/* Speaking */}
  <section id="speaking" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="speaking" title="On stage" href="/talks" hrefLabel="All talks" />

    <p class="mt-5 max-w-2xl text-(--text-muted)">
      {allTalks.length} talks and counting, across {conferences.slice(0, 4).join(', ')} and more.
    </p>

    <ul class="mt-10 divide-y divide-(--surface-border) border-y border-(--surface-border)">
      {talks.map((talk) => (
        <li>
          <a
            href={talk.data.url ?? '/talks'}
            target={talk.data.url ? '_blank' : undefined}
            rel={talk.data.url ? 'noopener noreferrer' : undefined}
            class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1.5 py-5"
          >
            <span class="flex-1 basis-64 font-medium transition-colors group-hover:text-(--tone-accent)">
              {talk.data.title}
              {talk.data.url && (
                <Icon
                  name="arrowUpRight"
                  size={13}
                  class="ml-1.5 inline-block opacity-0 transition-opacity group-hover:opacity-70"
                />
              )}
            </span>
            <span class="font-mono text-xs text-(--text-muted)">
              {[talk.data.conference, formatMonthYear(talk.data.date)].filter(Boolean).join(' · ')}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* Projects */}
  <section id="projects" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="projects" title="Things I've built" href="/projects" />

    {featured && (
      <a
        href={`/projects/${featured.id}`}
        class="surface-card surface-card-hover group mt-10 grid overflow-hidden md:grid-cols-2"
      >
        <div class="order-2 flex flex-col justify-center p-8 sm:p-10 md:order-1">
          <span class="kicker">Featured</span>
          <h3 class="mt-3 text-2xl font-semibold transition-colors group-hover:text-(--tone-accent) sm:text-3xl">
            {featured.data.name}
          </h3>
          <p class="mt-3 text-(--text-muted)">{featured.data.tagline}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 font-mono text-xs text-(--tone-accent)">
            View project
            <Icon
              name="arrowRight"
              size={14}
              class="transition-transform duration-300 group-hover:translate-x-1"
            />
          </span>
        </div>
        <div class="order-1 aspect-16/10 overflow-hidden md:order-2 md:aspect-auto">
          <Image
            src={featured.data.cover}
            alt={featured.data.coverAlt}
            width={900}
            height={640}
            loading="lazy"
            class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
      </a>
    )}

    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  {/* When I'm not working */}
  <section id="beyond" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" data-reveal>
    <SectionHeading kicker="offline" title="When I'm not working" />

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {interests.map((interest) => (
        <article class="surface-card overflow-hidden">
          <div class="aspect-4/3 overflow-hidden border-b border-(--surface-border)">
            <Image
              src={interest.image}
              alt={interest.alt}
              width={560}
              height={420}
              loading="lazy"
              class="size-full object-cover"
            />
          </div>
          <div class="p-6">
            <h3
              class="font-mono text-sm tracking-[0.14em] uppercase"
              style="color: var(--tone-accent)"
            >
              {interest.title}
            </h3>
            <p class="mt-3 text-sm text-(--text-muted)">{interest.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* Contact */}
  <section id="contact" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" data-reveal>
    <div class="surface-card grain relative overflow-hidden p-10 text-center sm:p-16">
      <div
        class="pointer-events-none absolute inset-x-0 -top-24 h-48 blur-[100px]"
        style="background: var(--glow-accent)"
        aria-hidden="true"
      ></div>

      <Prompt label="say hello" cursor />
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Get in touch</h2>
      <p class="mx-auto mt-4 max-w-md text-(--text-muted)">
        I'm always happy to talk about developer tools, Linux on Windows, or what you're building.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {socials.map((s) => (
          <ActionLink
            href={s.url}
            variant={s.icon === 'mail' ? 'primary' : 'ghost'}
            icon={s.icon}
            analytics={`contact_${s.icon}`}
            external={s.icon !== 'mail'}
          >
            {s.label}
          </ActionLink>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
